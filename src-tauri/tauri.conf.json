{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Grifo Quest",
  "version": "0.1.0",
  "identifier": "dev.grifoquest.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Grifo Quest",
        "width": 1040,
        "height": 740,
        "minWidth": 720,
        "minHeight": 520,
        "visible": false,
        "center": true,
        "backgroundColor": "#1b1a17"
      },
      {
        "label": "quick",
        "title": "Lançamento rápido",
        "width": 420,
        "height": 260,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "visible": false,
        "center": true,
        "backgroundColor": "#1b1a17"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
