{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Grifo Quest",
  "version": "0.3.0",
  "identifier": "dev.grifoquest.app",
  "build": {
    "beforeDevCommand": "node scripts/sidecar.mjs && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/sidecar.mjs && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Grifo Quest",
        "width": 1040,
        "height": 740,
        "minWidth": 720,
        "minHeight": 520,
        "visible": false,
        "center": true,
        "backgroundColor": "#15110c",
        "dragDropEnabled": false
      },
      {
        "label": "quick",
        "create": false,
        "title": "Lançamento rápido",
        "width": 420,
        "height": 260,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "visible": false,
        "center": true,
        "backgroundColor": "#15110c"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/grifo/": "grifo/"
    },
    "externalBin": [
      "binaries/grifo-quest-mcp"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Alberto Guth",
    "copyright": "© 2026 Alberto Guth. Todos os direitos reservados.",
    "shortDescription": "Monitor de estudos para concursos",
    "windows": {
      "nsis": {
        "languages": [
          "PortugueseBR"
        ],
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ0QkU4NUFFODc0QTg3QjAKUldTd2gwcUhyb1crMU9vbFFUWnYxYmZOcW5aUUhjZ1lWOTdIdUJHdk8yYkl2LzBRTTJ0bFB3QWMK",
      "endpoints": [
        "https://github.com/asguth/grifo-quest/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
